# ---- Auth (OAuth client: type "Web application") ----
AUTH_SECRET=                      # openssl rand -base64 32
AUTH_URL=http://localhost:3000    # your Cloud Run URL in prod
AUTH_TRUST_HOST=true

# The same OAuth client is used for sign-in and for Drive.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only these addresses can sign in. Comma separated, lowercase.
ALLOWED_EMAILS=you@gmail.com,her@gmail.com

# ---- Drive (the account that OWNS the library) ----
DRIVE_REFRESH_TOKEN=              # from: npm run drive:token
DRIVE_ROOT_FOLDER_ID=             # the Drive folder that is the top of the library

# ---- GCS (thumbnail cache) ----
GOOGLE_CLOUD_PROJECT=             # your GCP project ID
GCS_BUCKET=                       # the bucket that stores generated WebP thumbnails
