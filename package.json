{
  "name": "household",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p ${PORT:-8080}",
    "typecheck": "tsc --noEmit",
    "test:dates": "node --experimental-strip-types --no-warnings --test scripts/dates.test.mjs",
    "test:trips": "node --experimental-strip-types --no-warnings --test scripts/trips.test.mjs",
    "test:docs": "node --experimental-strip-types --no-warnings --test scripts/docs.test.mjs",
    "test:food": "node --experimental-strip-types --no-warnings --test scripts/fa-day.test.mjs",
    "drive:token": "node scripts/drive-token.mjs",
    "deploy": "gcloud run deploy household --source . --project=household-509314 --region=asia-southeast1 --allow-unauthenticated"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@google-cloud/firestore": "^7.11.0",
    "@google-cloud/storage": "^8.1.0",
    "googleapis": "^144.0.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.454.0",
    "next": "^15.5.25",
    "next-auth": "5.0.0-beta.25",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.4",
    "swr": "^2.2.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3"
  }
}
